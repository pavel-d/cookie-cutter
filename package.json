{
  "name": "cookie-cutter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.0.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build",
    "check": "npm run format:check && npm run typecheck && npm run build && vitest run && playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && vitest run",
    "test:browser": "npm run build && playwright test",
    "test:fixtures": "vitest run test/fixture-rules.test.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^22.20.5",
    "jsdom": "^26.0.0",
    "prettier": "^3.9.10",
    "typescript": "^5.7.3",
    "vite": "^6.4.5",
    "vitest": "^4.1.12"
  }
}
